use std::cli;
use console;
use pipit;

fn main() {
    let argv = cli_args();
    let count = args_len(argv);
    if count == 1 && args_at(argv, 0) == "--help" {
        println!("Plan the next CLI batch from child exit codes and a failure allowance.");
        println!("Usage: pipit codes total batch tolerance");
        println!("Vector arguments are comma-separated; use [] for an empty vector.");
        return;
    }
    let mut result = [];
    if count == 0 {
        result = pipit_continue_batch([0, 3, 0], 8.0, 2.0, 1.0);
    } else {
        if count != 4 { stderr_line("Wrong argument count. Use --help."); process_exit(2); }
        let codes = console_vector(args_at(argv, 0));
        let total = console_value(args_at(argv, 1));
        let batch = console_value(args_at(argv, 2));
        let tolerance = console_value(args_at(argv, 3));
        result = pipit_continue_batch(codes, total, batch, tolerance);
    }
    if len(result) == 0 { stderr_line("Invalid input for Pipit. See the package input contract."); process_exit(1); }
    let mut i = 0;
    while i < len(result) {
        println!(at(result, i));
        i += 1;
    }
}
